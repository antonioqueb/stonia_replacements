<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_replacements" model="ir.module.category">
        <field name="name">Reposiciones</field>
        <field name="description">Gestión de reposiciones de material.</field>
        <field name="sequence">86</field>
    </record>

    <record id="privilege_replacements" model="res.groups.privilege">
        <field name="name">Reposiciones</field>
        <field name="category_id" ref="module_category_replacements"/>
        <field name="sequence">10</field>
    </record>

    <!-- El prefijo "Reposiciones:" en los nombres ya no hace falta: la
         sección del selector da el contexto. Los XML ids no cambian. -->
    <record id="group_replacement_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="privilege_id" ref="privilege_replacements"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_replacement_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="privilege_replacements"/>
        <field name="implied_ids" eval="[(4, ref('group_replacement_user'))]"/>
    </record>

    <record id="group_replacement_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="privilege_id" ref="privilege_replacements"/>
        <field name="implied_ids" eval="[(4, ref('group_replacement_manager'))]"/>
        <field name="comment">Puede crear reposiciones con precio cero y acciones especiales.</field>
    </record>
</odoo>
