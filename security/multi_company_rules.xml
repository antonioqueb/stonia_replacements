<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multiempresa: la reposición vive en la compañía de su pedido;
             las líneas heredan la de la cabecera. Los motivos de
             devolución/reposición siguen compartidos (sin compañía). -->
        <record id="rule_sale_replacement_order_company" model="ir.rule">
            <field name="name">Orden de reposición: multiempresa</field>
            <field name="model_id" ref="model_sale_replacement_order"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

        <record id="rule_sale_replacement_order_line_company" model="ir.rule">
            <field name="name">Línea de reposición: multiempresa</field>
            <field name="model_id" ref="model_sale_replacement_order_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
